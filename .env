# Shared defaults loaded by Vite in every mode. Override per-environment in
# .env.local (gitignored), .env.development, .env.production, or via the
# deploy target's env vars.

# PartyKit host the y-partykit provider connects to. Required.
# In dev: localhost:1999 (the default `partykit dev` port).
# In prod: <project>.<account>.partykit.dev
VITE_PARTYKIT_HOST=localhost:1999
