# Shared defaults loaded by Vite in every mode. Override per-environment in
# .env.local (gitignored), .env.development, .env.production, or via the
# deploy target's env vars.

# Sync host the y-partyserver provider connects to. Required.
# In dev: localhost:1999 (the default `wrangler dev` port for our sync Worker).
# In prod: <worker-name>.<account>.workers.dev (or a custom route).
VITE_SYNC_HOST=localhost:1999
