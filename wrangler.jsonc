{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "loco-retro-sync",
	"main": "party/main.ts",
	"compatibility_date": "2026-05-01",
	"durable_objects": {
		"bindings": [{ "name": "RetroRoom", "class_name": "RetroRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RetroRoom"] }],
	"observability": { "enabled": true }
}
