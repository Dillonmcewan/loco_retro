{
  "name": "loco_retro",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "node"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "remoteUser": "node",
  "mounts": [
    // Per-project persisted volumes so auth + session state survive container
    // rebuilds. Scoped per project via ${devcontainerId}.
    "source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume",
    // Wrangler (Cloudflare) credentials — survives rebuild so `wrangler login`
    // is a one-time step.
    "source=wrangler-config-${devcontainerId},target=/home/node/.config/.wrangler,type=volume",
    // PartyKit credentials — same idea.
    "source=partykit-config-${devcontainerId},target=/home/node/.partykit,type=volume"
  ],
  "postCreateCommand": "sudo chown -R node:node /home/node/.claude /home/node/.config/.wrangler /home/node/.partykit && sudo corepack enable && corepack prepare pnpm@latest --activate && mkdir -p /home/node/.local/bin && printf '#!/bin/sh\\nfor arg in \"$@\"; do echo \"xdg-open (stub): $arg\"; done\\nexit 0\\n' > /home/node/.local/bin/xdg-open && chmod +x /home/node/.local/bin/xdg-open",
  "forwardPorts": [5173, 4173, 1999, 1998, 8976],
  "portsAttributes": {
    "5173": { "label": "SvelteKit dev", "onAutoForward": "notify" },
    "4173": { "label": "SvelteKit preview", "onAutoForward": "silent" },
    "1999": { "label": "PartyKit dev", "onAutoForward": "silent" },
    "1998": { "label": "PartyKit login callback", "onAutoForward": "silent" },
    "8976": { "label": "Wrangler login callback", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "vitest.explorer",
        "ms-playwright.playwright",
        "anthropic.claude-code"
      ]
    }
  }

  // NOTE: Egress firewall is intentionally omitted for v1. To add it later,
  // copy `.devcontainer/Dockerfile` and `.devcontainer/init-firewall.sh`
  // from https://github.com/anthropics/claude-code (see the reference
  // .devcontainer there) and switch this config from `image` to `build`.
}
