# Loaded by Vite during `vite build` (production mode). Committed so the prod
# build is reproducible from a clean checkout. Override locally with
# .env.production.local if needed.

# PartyKit host for the production worker. Replace <account> with the Cloudflare
# account subdomain printed by the first `pnpm party:deploy`.
VITE_PARTYKIT_HOST=loco-retro.<account>.partykit.dev
