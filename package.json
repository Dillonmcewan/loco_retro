{
	"name": "loco_retro",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "concurrently -n app,relay -c blue,green \"pnpm dev\" \"pnpm relay\"",
		"relay": "pnpm --filter relay start",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && oxlint",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.47.0",
		"@sveltejs/adapter-auto": "^3.2.0",
		"@sveltejs/kit": "^2.5.27",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/svelte": "^5.2.0",
		"@testing-library/user-event": "^14.5.0",
		"@types/node": "^22.5.0",
		"concurrently": "^9.0.0",
		"jsdom": "^25.0.0",
		"oxlint": "^1.63.0",
		"prettier": "^3.3.0",
		"prettier-plugin-svelte": "^3.2.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.5.0",
		"vite": "^5.4.0",
		"vitest": "^2.1.0"
	},
	"dependencies": {
		"y-indexeddb": "^9.0.12",
		"y-websocket": "^2.0.4",
		"yjs": "^13.6.20"
	}
}
