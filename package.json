{
	"name": "loco_retro",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "VITE_PARTYKIT_HOST=localhost:1999 concurrently -n app,party -c blue,green \"pnpm dev\" \"pnpm party:dev\"",
		"party:dev": "partykit dev",
		"party:deploy": "partykit deploy",
		"build": "vite build",
		"deploy:app": "vite build && wrangler pages deploy .svelte-kit/cloudflare --project-name=loco-retro --branch=main --commit-dirty=true",
		"deploy": "pnpm party:deploy && pnpm deploy:app",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^9.10.0",
		"@playwright/test": "^1.47.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.5.27",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/svelte": "^5.2.0",
		"@testing-library/user-event": "^14.5.0",
		"@types/node": "^22.5.0",
		"concurrently": "^9.0.0",
		"eslint": "^9.10.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.44.0",
		"globals": "^15.9.0",
		"jsdom": "^25.0.0",
		"partykit": "^0.0.115",
		"prettier": "^3.3.0",
		"prettier-plugin-svelte": "^3.2.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.5.0",
		"typescript-eslint": "^8.6.0",
		"vite": "^5.4.0",
		"vitest": "^2.1.0",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"lucide-svelte": "^1.0.1",
		"y-indexeddb": "^9.0.12",
		"y-partykit": "^0.0.33",
		"yjs": "^13.6.20"
	}
}
