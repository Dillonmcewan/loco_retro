{
	"name": "loco_retro",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"author": "Dillon McEwan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dillonmcewan/loco_retro.git"
	},
	"homepage": "https://github.com/dillonmcewan/loco_retro#readme",
	"bugs": {
		"url": "https://github.com/dillonmcewan/loco_retro/issues"
	},
	"packageManager": "pnpm@10.11.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "VITE_PARTYKIT_HOST=localhost:1999 concurrently -n app,party -c blue,green \"pnpm dev\" \"pnpm party:dev\"",
		"party:dev": "partykit dev",
		"party:deploy": "partykit deploy",
		"build": "vite build",
		"deploy:app": "vite build && wrangler pages deploy .svelte-kit/cloudflare --project-name=loco-retro --branch=main --commit-dirty=true",
		"deploy": "pnpm party:deploy && pnpm deploy:app",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/svelte": "^5.2.0",
		"@testing-library/user-event": "^14.5.0",
		"@types/node": "^25.9.0",
		"concurrently": "^9.0.0",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"partykit": "^0.0.115",
		"prettier": "^3.3.0",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.55.8",
		"svelte-check": "^4.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.13",
		"vitest": "^4.1.6",
		"@vitest/coverage-v8": "^4.1.6",
		"wrangler": "^4.92.0"
	},
	"dependencies": {
		"lucide-svelte": "^1.0.1",
		"y-indexeddb": "^9.0.12",
		"y-partykit": "^0.0.33",
		"yjs": "^13.6.20"
	}
}
