{
	"name": "loco_retro",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"author": "Dillon McEwan",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dillonmcewan/loco_retro.git"
	},
	"homepage": "https://github.com/dillonmcewan/loco_retro#readme",
	"bugs": {
		"url": "https://github.com/dillonmcewan/loco_retro/issues"
	},
	"packageManager": "pnpm@10.11.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "VITE_SYNC_HOST=localhost:1999 concurrently -n app,sync -c blue,green \"pnpm dev\" \"pnpm dev:sync\"",
		"dev:sync": "wrangler dev --config wrangler.sync.jsonc --port 1999 --local",
		"build": "vite build",
		"deploy": "pnpm deploy:sync && pnpm deploy:app",
		"deploy:app": "vite build && wrangler pages deploy .svelte-kit/cloudflare --project-name=loco-retro --branch=main --commit-dirty=true",
		"deploy:sync": "wrangler deploy --config wrangler.sync.jsonc",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.9.0",
		"@vitest/coverage-v8": "^4.1.6",
		"concurrently": "^10.0.3",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.1",
		"svelte": "^5.55.8",
		"svelte-check": "^4.4.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^8.0.13",
		"vitest": "^4.1.6",
		"wrangler": "^4.93.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.28.0",
		"partyserver": "^0.5.6",
		"y-indexeddb": "^9.0.12",
		"y-partyserver": "^2.2.0",
		"yjs": "^13.6.30"
	}
}
